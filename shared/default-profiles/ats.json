    "throttleKey": "W",
    "brakeKey": "S",
    "progressivePressure": true
  },
  "buttons": [
    { "id": "btn_engine", "label": "ENGINE", "key": "E", "type": "toggle", "icon": "power_settings_new", "category": "drivetrain" },
