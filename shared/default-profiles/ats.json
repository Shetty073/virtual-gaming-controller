    { "id": "btn_wipers", "label": "WIPERS", "key": "P", "type": "cycle", "icon": "water_drop", "category": "cabin" },
    { "id": "btn_cruise", "label": "CRUISE CTRL", "key": "C", "type": "toggle", "icon": "speed", "category": "assistance" },
    { "id": "btn_shift_up", "label": "GEAR UP", "key": "SHIFT", "type": "momentary", "icon": "keyboard_arrow_up", "category": "transmission" },
    { "id": "btn_shift_dn", "label": "GEAR DOWN", "key": "CTRL", "type": "momentary", "icon": "keyboard_arrow_down", "category": "transmission" },
    { "id": "btn_diff_lock", "label": "DIFF LOCK", "key": "V", "type": "toggle", "icon": "lock", "category": "drivetrain" },
