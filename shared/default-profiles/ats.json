{
  "id": "ats-default",
  "name": "American Truck Simulator",
  "description": "Standard control bindings and dashboard layout for ATS.",
  "steering": {
    "leftKey": "A",
    "rightKey": "D",
    "sensitivity": 1.0,
    "deadzone": 0.05,
    "linearity": 1.2
  },
