    { "id": "btn_blinker_l", "label": "LEFT BLINKER", "key": "[", "type": "toggle", "icon": "arrow_back", "category": "lighting" },
    { "id": "btn_blinker_r", "label": "RIGHT BLINKER", "key": "]", "type": "toggle", "icon": "arrow_forward", "category": "lighting" },
    { "id": "btn_hazard", "label": "HAZARD", "key": "F", "type": "toggle", "icon": "warning", "category": "lighting" },
    { "id": "btn_jake_brake", "label": "ENGINE BRAKE", "key": "B", "type": "toggle", "icon": "compress", "category": "drivetrain" },
    { "id": "btn_lights", "label": "LIGHTS", "key": "L", "type": "cycle", "icon": "wb_incandescent", "category": "lighting" },
